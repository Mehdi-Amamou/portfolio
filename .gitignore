# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# exemple d'environnement versionné
!.env.example

# tests et captures locales
/test-results
/playwright-report
/.lighthouse
/.captures

# images générées depuis assets/ (scripts/prepare-assets.mjs)
/public/generated
/.generated

# caches et réglages locaux
.cache/
.eslintcache
.turbo/
*.log
.claude/settings.local.json
